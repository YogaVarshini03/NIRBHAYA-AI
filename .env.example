# NIRBHAYA AI Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL

# App Mode (production = real integrations, demo = local presentation mode)
APP_MODE=production
PORT=5000

# Frontend Configuration & Public Link Base URL
APP_BASE_URL=http://localhost:5173
VITE_APP_BASE_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:5000
VITE_WEBSOCKET_URL=ws://localhost:5000/ws
VITE_GOOGLE_MAPS_API_KEY=

# Backend Security
DATABASE_URL=
JWT_SECRET=your_jwt_secret_min_32_characters_here

# SMS / Voice Provider Credentials (Twilio)
# Test recipient target: +91XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_VOICE_TWIML_URL=
SMS_PROVIDER_ACCOUNT_SID=
SMS_PROVIDER_AUTH_TOKEN=
SMS_FROM_NUMBER=

# Email Provider Credentials (Resend / SendGrid / SMTP)
# Test recipient target: guardian@example.com
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=emergency@nirbhaya.ai
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Cloud Evidence Storage (Optional - defaults to server uploads directory)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
